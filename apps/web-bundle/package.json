{
  "name": "@matatbread/matbot-web-bundle",
  "matbotRuntime": [
    "node",
    "browser"
  ],
  "version": "0.4.5",
  "engines": {
    "node": ">=24.0.0"
  },
  "description": "Self-contained, browser-only matbot: assembles the platform-neutral core and browser plugins into a single matbot.html that runs entirely client-side (file:// or any static host).",
  "keywords": [
    "matbot",
    "matbot-app",
    "browser",
    "llm",
    "ai",
    "agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    "src",
    "assemble.mjs",
    "serve.mjs",
    "index.template.html",
    "matbot.web.json",
    "matbot.web-demo.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "assemble": "npm run check:ui && node assemble.mjs",
    "assemble:demo": "npm run check:ui && node assemble.mjs matbot.web-demo.json",
    "serve": "node serve.mjs",
    "check:ui": "node ../../plugins/frontend/web/scripts/check-ui.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatAtBread/matbot.git",
    "directory": "apps/web-bundle"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@matatbread/matbot-core": "workspace:^",
    "@matatbread/matbot-plugin-api": "workspace:^",
    "@matatbread/matbot-browser": "workspace:^",
    "@matatbread/matbot-frontend-web": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "sucrase": "^3.35.0"
  }
}

{
  "name": "@matatbread/matbot-cli",
  "matbotRuntime": [
    "node"
  ],
  "version": "0.1.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src",
    "bin.js",
    "register.js",
    "ts-hooks.js"
  ],
  "type": "module",
  "bin": {
    "matbot": "bin.js"
  },
  "scripts": {
    "repl": "node bin.js",
    "start": "node bin.js start",
    "test": "node --import ./register.js --test test/loader.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@matatbread/matbot-core": "workspace:*",
    "@matatbread/matbot-files-node": "workspace:*",
    "@matatbread/matbot-storage-filesystem": "workspace:*",
    "@matatbread/matbot-tool-plugin": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:"
  }
}

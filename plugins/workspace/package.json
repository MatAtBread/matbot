{
  "name": "@matatbread/matbot-tool-workspace",
  "matbotRuntime": [
    "node",
    "browser"
  ],
  "version": "0.2.9",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src"
  ],
  "description": "Read, write, and list files in the session workspace. When the web frontend is running, all workspace files are also served as static read-only downloads at /workspace/<path> on the HTTP server, so you can give the user a direct link to any file you write there.",
  "keywords": [
    "matbot",
    "matbot-plugin",
    "llm",
    "ai",
    "agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatAtBread/matbot.git",
    "directory": "plugins/workspace"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@matatbread/matbot-plugin-api": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@matatbread/matbot-plugin-api": "workspace:^"
  }
}

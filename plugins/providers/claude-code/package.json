{
  "name": "@matatbread/matbot-provider-claude-code",
  "matbotRuntime": [
    "node"
  ],
  "version": "0.3.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src"
  ],
  "description": "Provider adapter that drives the local Claude Code CLI (`claude -p`) as a single-turn structured-completion backend, so inference is billed to the user's Claude subscription. matbot keeps the agentic loop and runs the tools; Claude Code never executes anything.",
  "keywords": [
    "matbot",
    "matbot-plugin",
    "matbot-provider",
    "claude-code",
    "subscription",
    "llm",
    "ai",
    "agent"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatAtBread/matbot.git",
    "directory": "plugins/providers/claude-code"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@matatbread/matbot-plugin-api": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@matatbread/matbot-plugin-api": "workspace:^"
  }
}

{
  "name": "@matatbread/matbot-tool-ts-validation",
  "matbotRuntime": [
    "node"
  ],
  "version": "0.4.12",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "src"
  ],
  "description": "Validates tool-call inputs against each tool's ToolContract params TYPE (not its projected JSON Schema), returning an error result on mismatch so the model can self-correct. Hard-depends on @matatbread/matbot-tool-types (node only), installing it itself if it is not already loaded — so there is no load-order requirement.",
  "keywords": [
    "matbot",
    "matbot-plugin",
    "llm",
    "ai",
    "agent",
    "typescript"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MatAtBread/matbot.git",
    "directory": "plugins/ts-validation"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@matatbread/matbot-tool-types": "workspace:^"
  },
  "peerDependencies": {
    "@matatbread/matbot-plugin-api": "workspace:^",
    "@matatbread/matbot-core": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "@matatbread/matbot-plugin-api": "workspace:^",
    "@matatbread/matbot-core": "workspace:^",
    "@matatbread/matbot-tool-types": "workspace:^"
  }
}

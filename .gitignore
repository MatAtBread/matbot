node_modules/
dist/
*.tsbuildinfo

# Local env files — never commit
.env
.env.*
!.env.example
.data*
.claude/settings.local.json
matbot.yaml
matbot.*.yaml
# macOS
.DS_Store

# The web bundle is a shippable, self-contained artifact — keep it tracked even
# though dist/ is ignored everywhere else. Re-including the directory is required
# before the file (per gitignore precedence), but on its own it un-ignores the
# directory's *entire* contents; re-ignore them with the wildcard, then carve out
# just the shipped html.
!apps/web-bundle/dist/
apps/web-bundle/dist/*
!apps/web-bundle/dist/matbot.html

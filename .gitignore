node_modules/
dist/
*.tsbuildinfo

# Local env files — never commit
.env
.env.*
!.env.example
.data*
.claude/settings.local.json
matbot.yaml
matbot.*.yaml
# macOS
.DS_Store

# The web bundles are shippable, self-contained artifacts — keep them tracked even
# though dist/ is ignored everywhere else. Re-including the directory is required
# before the files (per gitignore precedence), but on its own it un-ignores the
# directory's *entire* contents; re-ignore them with the wildcard, then carve out
# just the shipped html (the rich UI and the dom demonstrator).
!apps/web-bundle/dist/
apps/web-bundle/dist/*
!apps/web-bundle/dist/matbot.html
!apps/web-bundle/dist/matbot-demo.html

{
  "name": "matbot",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm --filter @matatbread/matbot-cli test",
    "check:docs": "node scripts/check-docs.mjs",
    "check:isolation": "node scripts/check-base-isolation.mjs",
    "repl": "pnpm --filter @matatbread/matbot-cli repl",
    "start": "pnpm --filter @matatbread/matbot-cli start",
    "web-build": "pnpm --filter @matatbread/matbot-web-bundle assemble && pnpm --filter @matatbread/matbot-web-bundle assemble:demo",
    "web-server": "pnpm --filter @matatbread/matbot-web-bundle serve",
    "publish-app": "pnpm --filter '@matatbread/matbot-cli...' publish",
    "publish-all": "pnpm -r publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "typescript": "^5.8.0"
  }
}

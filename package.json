{
  "name": "matbot",
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "typecheck":  "pnpm -r run typecheck",
    "check:docs": "node scripts/check-docs.mjs",
    "repl":       "pnpm --filter @matatbread/matbot-cli repl",
    "start":      "pnpm --filter @matatbread/matbot-cli start",
    "web-build":  "pnpm --filter @matatbread/matbot-web-bundle assemble",
    "web-server": "pnpm --filter @matatbread/matbot-web-bundle serve"
  },
  "devDependencies": {
    "typescript": "^5.8.0"
  }
}
